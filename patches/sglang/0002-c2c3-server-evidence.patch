+"""Opt-in, fail-closed evidence for the Qwen3.8 C2/C3 campaign.
+
+Set ``SGLANG_C2C3_EVIDENCE_PATH`` to an absolute JSONL path before starting
+the server.  The scheduler process is the sole JSONL writer.  API processes
+use the same opt-in to preserve X-Request-ID and annotate emitted SSE tokens,
+but never write scheduler transitions.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import json
+import os
+import pathlib
+import threading
+import time
+from typing import Any, Mapping, MutableMapping, Sequence
+
+ENV_NAME = "SGLANG_C2C3_EVIDENCE_PATH"
+SCHEMA = "qwen38.server-scheduler-event"
+SOURCE = "server_scheduler"
+
+_singleton_lock = threading.Lock()
+_recorder = None
+
+
+def configured_path() -> pathlib.Path | None:
+    raw = os.environ.get(ENV_NAME)
+    if raw is None or not raw.strip():
+        return None
+    path = pathlib.Path(raw)
+    if not path.is_absolute():
+        raise ValueError(f"{ENV_NAME} must be an absolute path")
+    return path
+
+
+def enabled() -> bool:
+    return configured_path() is not None
+
+
+def request_id_from_headers(headers: Mapping[str, str] | None) -> str | None:
+    """Return the campaign correlation ID only while evidence is enabled."""
+    if not enabled() or headers is None:
+        return None
+    value = headers.get("x-request-id")
+    if value is None:
+        raise ValueError("C2/C3 evidence requires X-Request-ID")
+    value = value.strip()
+    if not value or len(value) > 256 or any(ord(char) < 0x20 for char in value):
+        raise ValueError("X-Request-ID must be 1-256 visible characters")
+    return value
+
+
+def stream_token_ids(
+    output_ids: Sequence[int],
+    *,
+    incremental: bool,
+    offsets: MutableMapping[int, int],
+    index: int,
+) -> list[int]:
+    """Return only newly emitted scheduler token IDs for one choice."""
+    if not enabled():
+        return []
+    all_ids = [int(token_id) for token_id in output_ids]
+    if incremental:
+        token_ids = all_ids
+    else:
+        offset = offsets.get(index, 0)
+        if offset < 0 or offset > len(all_ids):
+            raise ValueError("non-monotonic OpenAI output token stream")
+        token_ids = all_ids[offset:]
+        offsets[index] = len(all_ids)
+    return token_ids
+
+
+def token_emission_timestamps(
+    token_ids: Sequence[int], state: MutableMapping[str, int]
+) -> list[float]:
+    """Timestamp tokens immediately before their SSE chunk is serialized."""
+    timestamps = []
+    last_ns = state.get("last_ns", 0)
+    for _ in token_ids:
+        # Epoch-scale JSON floats need a microsecond floor to remain distinct.
+        last_ns = max(time.time_ns(), last_ns + 1_000)
+        timestamps.append(last_ns / 1_000_000_000)
+    state["last_ns"] = last_ns
+    return timestamps
+
+
+def _process_identity() -> str:
+    stat = pathlib.Path(f"/proc/{os.getpid()}/stat").read_text()
+    tail = stat[stat.rfind(")") + 2 :].split()
+    return f"pid:{os.getpid()}:start_ticks:{tail[19]}"
+
+
+class NullRecorder:
+    def queued(self, request_id: str) -> None:
+        pass
+
+    def admitted(self, request_id: str) -> None:
+        pass
+
+    def started(self, request_id: str) -> None:
+        pass
+
+    def terminal(self, request_id: str, *, failed: bool) -> None:
+        pass
+
+
+class SchedulerEvidenceRecorder:
+    """Append compact post-transition records with one scheduler-thread write."""
+
+    def __init__(self, path: pathlib.Path):
+        if not path.parent.is_dir():
+            raise ValueError(f"evidence directory does not exist: {path.parent}")
+        self._fd = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
+        self._lock = threading.Lock()
+        self._queued: set[str] = set()
+        self._active: set[str] = set()
+        self._started: set[str] = set()
+        self.server_process_id = _process_identity()
+
+    def _emit(self, event: str, request_id: str) -> None:
+        row: dict[str, Any] = {
+            "schema": SCHEMA,
+            "source": SOURCE,
+            "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
+            "event": event,
+            "client_request_id": request_id,
+            "server_process_id": self.server_process_id,
+            "running": len(self._active),
+            "queued": len(self._queued),
+        }
+        payload = (json.dumps(row, separators=(",", ":")) + "\n").encode()
+        if len(payload) > 4096:
+            raise ValueError("scheduler evidence record exceeds atomic line budget")
+        # O_APPEND plus one write retains complete lines across concurrent
+        # producers.  No fsync is done on the scheduler hot path; completed
+        # writes survive client timeout/disconnect and normal container stop.
+        written = os.write(self._fd, payload)
+        if written != len(payload):
+            raise OSError("short scheduler evidence write")
+
+    def queued(self, request_id: str) -> None:
+        with self._lock:
+            if request_id in self._queued or request_id in self._active:
+                return
+            self._queued.add(request_id)
+            self._emit("queued", request_id)
+
+    def admitted(self, request_id: str) -> None:
+        with self._lock:
+            if request_id in self._active:
+                return
+            self._queued.discard(request_id)
+            self._active.add(request_id)
+            self._emit("admitted", request_id)
+
+    def started(self, request_id: str) -> None:
+        with self._lock:
+            if request_id not in self._active or request_id in self._started:
+                return
+            self._started.add(request_id)
+            self._emit("started", request_id)
+
+    def terminal(self, request_id: str, *, failed: bool) -> None:
+        with self._lock:
+            if request_id not in self._active:
+                return
+            self._active.remove(request_id)
+            self._queued.discard(request_id)
+            self._started.discard(request_id)
+            self._emit("failed" if failed else "completed", request_id)
+
+
+def get_scheduler_recorder(*, primary_rank: bool = True):
+    """Return one process-local recorder, or a no-op when disabled/non-primary."""
+    global _recorder
+    if not primary_rank or not enabled():
+        return NullRecorder()
+    with _singleton_lock:
+        if _recorder is None:
+            _recorder = SchedulerEvidenceRecorder(configured_path())
+        return _recorder
